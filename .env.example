# Copy to server/.env (never commit real values).
PORT=5000
# MongoDB makes saved fields/zones durable. Without it the server runs in
# memory-only mode and data is lost on restart (the UI shows a warning).
MONGODB_URI=mongodb://127.0.0.1:27017/agricotton
# Use a long random value in any real deployment.
JWT_SECRET=change-me
NODE_ENV=development
